# ==============================================================================
# InterviewLens AI - Backend Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust values for local development.

# --- Application Settings ---
APP_NAME="InterviewLens AI Backend"
APP_VERSION="0.1.0"
APP_ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# --- Security & JWT Authentication ---
# Generate a cryptographically secure 64-byte random key in production:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="replace-with-a-secure-random-64-character-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Database ---
# Local lightweight async SQLite (default):
DATABASE_URL="sqlite+aiosqlite:///./interviewlens.db"
# Example PostgreSQL URL for production staging:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/interviewlens"

# --- Cross-Origin Resource Sharing (CORS) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# --- Storage & Audio Recordings ---
STORAGE_DIR="storage"
RECORDINGS_DIR="storage/recordings"
MAX_UPLOAD_SIZE_BYTES=26214400 # 25 MB

# --- Speech Analysis Engine ---
WHISPER_MODEL_SIZE="tiny" # tiny, base, small (tiny recommended for 8GB RAM development)
WHISPER_DEVICE="cpu"
WHISPER_COMPUTE_TYPE="int8"
SILENCE_ENERGY_THRESHOLD_DB=-35.0
MIN_SILENCE_DURATION_SECONDS=0.5
LONG_PAUSE_DURATION_SECONDS=2.0

# --- Logging ---
LOG_LEVEL="INFO"
